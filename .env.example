DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=maehan_leads
# Create this in the Groq console. It is the only key needed for the
# default GPT-OSS configuration below.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# LiteLLM provider/model format. This routes GPT-OSS-120B through Groq.
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=gemini/gemini-3.7-flash
LEAD_RATE_LIMIT_PER_HOUR=10
CHAT_RATE_LIMIT_PER_HOUR=30
ABSTRACT_EMAIL_VALIDATION_API_KEY=

# Brevo SMTP Configuration
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=maehansolutions@gmail.com